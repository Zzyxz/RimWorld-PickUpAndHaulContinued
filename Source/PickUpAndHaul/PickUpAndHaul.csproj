<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
		<TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
		<TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
		<RootNamespace>PickUpAndHaul</RootNamespace>
		<AssemblyName>PickUpAndHaul</AssemblyName>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<Deterministic>true</Deterministic>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputPath>..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<PublicizeAsReferenceAssemblies>false</PublicizeAsReferenceAssemblies>
		<HarmonyModDir>D:\SteamLibrary\steamapps\workshop\content\294100\2009463077</HarmonyModDir>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
		<DefineConstants>$(DefineConstants);RW17</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="bin\**;obj\**" />
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<Publicize Include="Assembly-CSharp" />
		<ProjectReference Include="..\IHoldMultipleThings\IHoldMultipleThings.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4523" />
		<PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" />
	</ItemGroup>
	<ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.2" />
		<Reference Include="0Harmony">
			<HintPath>$(HarmonyModDir)\1.7\Assemblies\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
