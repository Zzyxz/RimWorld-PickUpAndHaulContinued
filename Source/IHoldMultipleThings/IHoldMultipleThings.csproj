<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
		<TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
		<TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
		<RootNamespace>IHoldMultipleThings</RootNamespace>
		<AssemblyName>IHoldMultipleThings</AssemblyName>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<Deterministic>true</Deterministic>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputPath>..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="bin\**;obj\**" />
	</ItemGroup>
	<ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4523" />
	</ItemGroup>
	<ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.2" />
	</ItemGroup>
</Project>
